<UserControl x:Class="PCVerwaltung.Controls.JettGptChatWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Width="350"
            Height="390"
            Padding="16"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Jett.gpt"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextBrush}" />

                <Button Grid.Column="1"
                        Content="X"
                        Width="32"
                        Height="32"
                        Background="Red"
                        Foreground="White"
                        ToolTip="Chat schließen"
                        Click="CloseButton_Click" />
            </Grid>

            <ScrollViewer x:Name="ChatScrollViewer"
                          Grid.Row="1"
                          Margin="0,16,0,12"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="AiInputBox"
                         Height="38"
                         Margin="0,0,8,0"
                         Padding="8"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource AppTextBrush}"
                         Background="{DynamicResource AppBackgroundBrush}"
                         BorderBrush="{DynamicResource AppBorderBrush}"
                         materialDesign:HintAssist.Hint="Nachricht eingeben"
                         KeyDown="AiInputBox_KeyDown" />

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Senden"
                        Height="38"
                        Padding="12,0"
                        Background="{DynamicResource AppAccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SendButton_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
